<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:background="@color/card_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔬 Brownian NTA Lab"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFpsHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60 FPS"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#1a00f2fe"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Navigation Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        app:tabTextColor="@color/text_muted"
        app:tabSelectedTextColor="@color/accent_cyan"
        app:tabIndicatorColor="@color/accent_cyan"
        app:tabMode="fixed">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔬 Sim" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 Camera" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁 Video" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 Analytics" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Camera Preview & Viewport Canvas Container -->
    <FrameLayout
        android:id="@+id/viewportContainer"
        android:layout_width="match_parent"
        android:layout_height="250dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/simCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />

        <com.brownian.tracker.ui.OverlayView
            android:id="@+id/overlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Status HUD -->
        <TextView
            android:id="@+id/tvStatusHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:text="Ready • Simulator Active"
            android:textColor="@color/text_main"
            android:textSize="11sp"
            android:background="#cc161e2e"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </FrameLayout>

    <!-- Toolbar Action Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#0e1422">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start"
            android:textColor="#0b0f19"
            android:backgroundTint="@color/accent_cyan" />

        <Button
            android:id="@+id/btnPause"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pause"
            android:textColor="@color/text_main"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/btnCalibrate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Calibrate"
            android:textColor="@color/accent_cyan"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear"
            android:textColor="@color/accent_magenta"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Real-time Metrics Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@color/card_bg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extracted Temp (T)"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTempVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20.0 °C"
                android:textColor="@color/accent_cyan"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diffusion Coeff (D)"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvDiffVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 μm²/s"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mean Diameter (d̄)"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvSizeVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.00 μm"
                android:textColor="@color/accent_magenta"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Tab Content Panels -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TAB 1: SIMULATOR CONTROLS -->
            <LinearLayout
                android:id="@+id/panelSim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchMilkMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Simulate Milk / Polydisperse Size Distribution"
                    android:textColor="@color/text_main"
                    android:checked="false" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDriftFix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Subtract Bulk Flow (Drift Correction)"
                    android:textColor="@color/text_main"
                    android:checked="false" />

                <!-- 1. TEMPERATURE CONTROL (Text + Slider) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvTempSliderLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Temperature (°C):"
                        android:textColor="@color/text_muted" />

                    <EditText
                        android:id="@+id/etTempInput"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="20.0"
                        android:textColor="@color/accent_cyan"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="#1a1e2e"
                        android:padding="6dp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBarTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="60"
                    android:progress="20" />

                <!-- 2. VISCOSITY CONTROL (Text + Slider) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvViscSliderLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Viscosity (mPa·s):"
                        android:textColor="@color/text_muted" />

                    <EditText
                        android:id="@+id/etViscInput"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="1.00"
                        android:textColor="@color/accent_cyan"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="#1a1e2e"
                        android:padding="6dp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBarVisc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="10" />

                <!-- 3. FLUID DRIFT CONTROL (Text + Slider) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvDriftSliderLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fluid Drift (μm/s):"
                        android:textColor="@color/text_muted" />

                    <EditText
                        android:id="@+id/etDriftInput"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="0.00"
                        android:textColor="@color/accent_cyan"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="#1a1e2e"
                        android:padding="6dp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBarDrift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="30"
                    android:progress="0" />

                <!-- 4. MEAN PARTICLE SIZE CONTROL (Text + Slider) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvSizeSliderLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Particle Diameter (μm):"
                        android:textColor="@color/text_muted" />

                    <EditText
                        android:id="@+id/etSizeInput"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="2.00"
                        android:textColor="@color/accent_magenta"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="#1a1e2e"
                        android:padding="6dp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBarSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="20" />
            </LinearLayout>

            <!-- TAB 2: LIVE CAMERA CONTROLS -->
            <LinearLayout
                android:id="@+id/panelCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷 Camera Controls &amp; Crop Zoom"
                    android:textColor="@color/text_main"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchShowOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Particle Detection &amp; Tracking Overlays"
                    android:textColor="@color/text_main"
                    android:checked="true"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvZoomSliderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Digital Sensor Crop Zoom: 1.0x (FOV: ~4.0 mm)"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />
                <SeekBar
                    android:id="@+id/seekBarZoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0" />

                <Button
                    android:id="@+id/btnToggleTorch"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Toggle Phone Flashlight / Torch"
                    android:textColor="@color/accent_cyan"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- TAB 3: VIDEO FILE CONTROLS -->
            <LinearLayout
                android:id="@+id/panelVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📁 Analyze Recorded Video File"
                    android:textColor="@color/text_main"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSelectVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Video File from Phone"
                    android:textColor="#0b0f19"
                    android:backgroundTint="@color/accent_cyan"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- TAB 4: ANALYTICS DASHBOARD -->
            <LinearLayout
                android:id="@+id/panelAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <com.brownian.tracker.ui.AnalyticsChartView
                    android:id="@+id/msdChartView"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />

                <com.brownian.tracker.ui.AnalyticsChartView
                    android:id="@+id/psdChartView"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

</LinearLayout>
